{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cheapcoin.fun/schemas/diamond-drop-v4.schema.json",
  "title": "CheapCoin combined Diamond Drop artifact v4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "chainId", "dropId", "rewardAsset", "assetContextHash",
    "window", "rewardAmount", "funding", "holderPool", "communityPool",
    "recipientCount", "allocationRoot", "batchesRoot", "expectedBatches",
    "safeCreateDropCalldata", "safeFinalizeDropCalldata",
    "safeCreateDropTransaction", "safeFinalizeDropTransaction", "allocations", "batches"
  ],
  "properties": {
    "schemaVersion": { "const": 4 },
    "chainId": { "const": 4663 },
    "dropId": { "$ref": "#/$defs/bytes32" },
    "rewardAsset": { "$ref": "#/$defs/rewardAsset" },
    "assetContextHash": { "$ref": "#/$defs/bytes32" },
    "window": { "$ref": "#/$defs/holderWindow" },
    "rewardAmount": { "$ref": "#/$defs/positiveDecimal" },
    "funding": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "holderRewardAmount", "communityRewardAmount"],
          "properties": {
            "mode": { "const": "separate_budget" },
            "holderRewardAmount": { "$ref": "#/$defs/positiveDecimal" },
            "communityRewardAmount": { "$ref": "#/$defs/positiveDecimal" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "holderRewardAmount", "communityRewardAmount", "communityBps"],
          "properties": {
            "mode": { "const": "shared_drop_bps" },
            "holderRewardAmount": { "$ref": "#/$defs/positiveDecimal" },
            "communityRewardAmount": { "$ref": "#/$defs/positiveDecimal" },
            "communityBps": { "type": "integer", "minimum": 1, "maximum": 9999 }
          }
        }
      ]
    },
    "holderPool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rewardAmount", "floorTokenAmount", "eligibleCount", "totalWeight",
        "snapshotHash", "snapshot", "allocations"
      ],
      "properties": {
        "rewardAmount": { "$ref": "#/$defs/positiveDecimal" },
        "floorTokenAmount": { "$ref": "#/$defs/positiveDecimal" },
        "eligibleCount": { "type": "integer", "minimum": 1 },
        "totalWeight": { "$ref": "#/$defs/positiveDecimal" },
        "snapshotHash": { "$ref": "#/$defs/bytes32" },
        "snapshot": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/holderSnapshotEntry" }
        },
        "allocations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/holderAllocation" }
        }
      }
    },
    "communityPool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rewardAmount", "contributorCount", "totalPoints", "score", "allocations"],
      "properties": {
        "rewardAmount": { "$ref": "#/$defs/positiveDecimal" },
        "contributorCount": { "type": "integer", "minimum": 1 },
        "totalPoints": { "$ref": "#/$defs/positiveDecimal" },
        "score": { "$ref": "#/$defs/communityScore" },
        "allocations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/communityAllocation" }
        }
      }
    },
    "recipientCount": { "type": "integer", "minimum": 1 },
    "allocationRoot": { "$ref": "#/$defs/bytes32" },
    "batchesRoot": { "$ref": "#/$defs/bytes32" },
    "expectedBatches": { "type": "integer", "minimum": 1 },
    "safeCreateDropCalldata": { "$ref": "#/$defs/hexData" },
    "safeFinalizeDropCalldata": { "$ref": "#/$defs/hexData" },
    "safeCreateDropTransaction": { "$ref": "#/$defs/transaction" },
    "safeFinalizeDropTransaction": { "$ref": "#/$defs/transaction" },
    "allocations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/mergedAllocation" }
    },
    "batches": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/batch" }
    }
  },
  "$defs": {
    "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "bytes32": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
    "decimal": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
    "positiveDecimal": { "type": "string", "pattern": "^[1-9][0-9]*$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "hexData": { "type": "string", "pattern": "^0x(?:[0-9a-fA-F]{2})*$" },
    "rewardAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tokenAddress", "distributorAddress", "symbol", "name", "decimals"],
      "properties": {
        "tokenAddress": { "$ref": "#/$defs/address" },
        "distributorAddress": { "$ref": "#/$defs/address" },
        "symbol": { "type": "string", "pattern": "^[A-Z0-9._-]{1,16}$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "decimals": { "type": "integer", "minimum": 0, "maximum": 36 }
      }
    },
    "holderWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "startBlock", "endBlock", "rulesVersion", "rulesPath", "rulesSha256"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 1 },
        "startBlock": { "$ref": "#/$defs/decimal" },
        "endBlock": { "$ref": "#/$defs/decimal" },
        "rulesVersion": { "type": "string", "minLength": 1 },
        "rulesPath": { "type": "string", "pattern": "^rules/RULES-v[0-9A-Za-z._-]+\\.md$" },
        "rulesSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "holderSnapshotEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["address", "minimumBalance", "streak", "excluded"],
      "properties": {
        "address": { "$ref": "#/$defs/address" },
        "minimumBalance": { "$ref": "#/$defs/decimal" },
        "streak": { "type": "integer", "minimum": 0 },
        "excluded": { "type": "boolean" }
      }
    },
    "holderAllocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["address", "minimumBalance", "streak", "multiplierBps", "weight", "amount"],
      "properties": {
        "address": { "$ref": "#/$defs/address" },
        "minimumBalance": { "$ref": "#/$defs/decimal" },
        "streak": { "type": "integer", "minimum": 0 },
        "multiplierBps": { "$ref": "#/$defs/decimal" },
        "weight": { "$ref": "#/$defs/positiveDecimal" },
        "amount": { "$ref": "#/$defs/positiveDecimal" }
      }
    },
    "communityRound": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sequence", "startTime", "endTime", "rulesVersion", "rulesPath", "rulesSha256"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "sequence": { "type": "integer", "minimum": 1 },
        "startTime": { "type": "integer", "minimum": 0 },
        "endTime": { "type": "integer", "minimum": 0 },
        "rulesVersion": { "type": "string", "minLength": 1 },
        "rulesPath": { "type": "string", "pattern": "^rules/COMMUNITY-RULES-v[0-9A-Za-z._-]+\\.md$" },
        "rulesSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "communityRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "points", "perUtcDay", "perRound"],
      "properties": {
        "action": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$" },
        "points": { "$ref": "#/$defs/positiveDecimal" },
        "perUtcDay": { "type": "integer", "minimum": 1 },
        "perRound": { "type": "integer", "minimum": 1 }
      }
    },
    "approvedEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eventCommitment", "address", "action", "occurredAt"],
      "properties": {
        "eventCommitment": { "$ref": "#/$defs/bytes32" },
        "address": { "$ref": "#/$defs/address" },
        "action": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$" },
        "occurredAt": { "type": "integer", "minimum": 0 }
      }
    },
    "acceptedEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eventCommitment", "address", "action", "occurredAt", "points"],
      "properties": {
        "eventCommitment": { "$ref": "#/$defs/bytes32" },
        "address": { "$ref": "#/$defs/address" },
        "action": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$" },
        "occurredAt": { "type": "integer", "minimum": 0 },
        "points": { "$ref": "#/$defs/positiveDecimal" }
      }
    },
    "rejectedEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eventCommitment", "address", "action", "occurredAt", "reason"],
      "properties": {
        "eventCommitment": { "$ref": "#/$defs/bytes32" },
        "address": { "$ref": "#/$defs/address" },
        "action": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$" },
        "occurredAt": { "type": "integer", "minimum": 0 },
        "reason": { "enum": ["excluded_address", "daily_cap", "round_cap"] }
      }
    },
    "contributor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["address", "points", "acceptedEvents"],
      "properties": {
        "address": { "$ref": "#/$defs/address" },
        "points": { "$ref": "#/$defs/positiveDecimal" },
        "acceptedEvents": { "type": "integer", "minimum": 1 }
      }
    },
    "communityScore": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "round", "rules", "approvedEvents", "excludedAddresses",
        "contributors", "acceptedEvents", "rejectedEvents", "totalPoints",
        "inputCommitment", "outputCommitment"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "round": { "$ref": "#/$defs/communityRound" },
        "rules": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/communityRule" } },
        "approvedEvents": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/approvedEvent" } },
        "excludedAddresses": { "type": "array", "items": { "$ref": "#/$defs/address" } },
        "contributors": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/contributor" } },
        "acceptedEvents": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/acceptedEvent" } },
        "rejectedEvents": { "type": "array", "items": { "$ref": "#/$defs/rejectedEvent" } },
        "totalPoints": { "$ref": "#/$defs/positiveDecimal" },
        "inputCommitment": { "$ref": "#/$defs/bytes32" },
        "outputCommitment": { "$ref": "#/$defs/bytes32" }
      }
    },
    "communityAllocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["address", "points", "acceptedEvents", "amount"],
      "properties": {
        "address": { "$ref": "#/$defs/address" },
        "points": { "$ref": "#/$defs/positiveDecimal" },
        "acceptedEvents": { "type": "integer", "minimum": 1 },
        "amount": { "$ref": "#/$defs/positiveDecimal" }
      }
    },
    "mergedAllocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["address", "holderAmount", "communityAmount", "amount", "leaf", "proof"],
      "properties": {
        "address": { "$ref": "#/$defs/address" },
        "holderAmount": { "$ref": "#/$defs/decimal" },
        "communityAmount": { "$ref": "#/$defs/decimal" },
        "amount": { "$ref": "#/$defs/positiveDecimal" },
        "leaf": { "$ref": "#/$defs/bytes32" },
        "proof": { "type": "array", "items": { "$ref": "#/$defs/bytes32" } }
      }
    },
    "batch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "recipients", "amounts", "batchHash", "leaf", "proof", "operatorCalldata", "operatorTransaction"],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "recipients": { "type": "array", "minItems": 1, "maxItems": 200, "items": { "$ref": "#/$defs/address" } },
        "amounts": { "type": "array", "minItems": 1, "maxItems": 200, "items": { "$ref": "#/$defs/positiveDecimal" } },
        "batchHash": { "$ref": "#/$defs/bytes32" },
        "leaf": { "$ref": "#/$defs/bytes32" },
        "proof": { "type": "array", "items": { "$ref": "#/$defs/bytes32" } },
        "operatorCalldata": { "$ref": "#/$defs/hexData" },
        "operatorTransaction": { "$ref": "#/$defs/transaction" }
      }
    },
    "transaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["to", "value", "data"],
      "properties": {
        "to": { "$ref": "#/$defs/address" },
        "value": { "const": "0" },
        "data": { "$ref": "#/$defs/hexData" }
      }
    }
  }
}
