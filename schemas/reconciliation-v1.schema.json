{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cheapcoin.fun/schemas/reconciliation-v1.schema.json",
  "title": "CheapCoin Diamond Drop reconciliation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "chainId",
    "dropId",
    "rewardAsset",
    "distributorAddress",
    "artifactPath",
    "artifactSha256",
    "createDropTxHash",
    "batchTxHashes",
    "finalizeDropTxHash",
    "fundedAmount",
    "distributedAmount",
    "returnedDust",
    "completedAt"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "chainId": { "const": 4663 },
    "dropId": { "$ref": "#/$defs/bytes32" },
    "rewardAsset": { "$ref": "#/$defs/address" },
    "distributorAddress": { "$ref": "#/$defs/address" },
    "artifactPath": { "type": "string", "pattern": "^drops/.+\\.json$" },
    "artifactSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "createDropTxHash": { "$ref": "#/$defs/bytes32" },
    "batchTxHashes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/bytes32" } },
    "finalizeDropTxHash": { "$ref": "#/$defs/bytes32" },
    "fundedAmount": { "$ref": "#/$defs/decimal" },
    "distributedAmount": { "$ref": "#/$defs/decimal" },
    "returnedDust": { "$ref": "#/$defs/decimal" },
    "completedAt": { "type": "string", "format": "date-time" },
    "notes": { "type": "string", "maxLength": 2000 }
  },
  "$defs": {
    "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "bytes32": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
    "decimal": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" }
  }
}
