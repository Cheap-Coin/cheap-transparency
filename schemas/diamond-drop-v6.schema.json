{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cheapcoin.fun/schemas/diamond-drop-v6.schema.json",
  "title": "CheapCoin strict COST Diamond Drop artifact v6",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "program", "chainId", "dropId", "rewardAsset", "assetContextHash",
    "window", "rewardAmount", "floorTokenAmount", "eligibilityRule", "eligibleCount",
    "totalWeight", "holderSnapshotHash", "holderSnapshot", "allocationRoot", "batchesRoot",
    "expectedBatches", "safeCreateDropCalldata", "safeFinalizeDropCalldata",
    "safeCreateDropTransaction", "safeFinalizeDropTransaction", "allocations", "batches"
  ],
  "properties": {
    "schemaVersion": { "const": 6 },
    "program": { "const": "cost_diamond_drop" },
    "chainId": { "const": 4663 },
    "dropId": { "$ref": "diamond-drop-v4.schema.json#/$defs/bytes32" },
    "rewardAsset": { "$ref": "diamond-drop-v4.schema.json#/$defs/rewardAsset" },
    "assetContextHash": { "$ref": "diamond-drop-v4.schema.json#/$defs/bytes32" },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence", "startBlock", "endBlock", "rulesVersion", "rulesPath", "rulesSha256", "selection"
      ],
      "properties": {
        "sequence": { "type": "integer", "minimum": 1 },
        "startBlock": { "$ref": "diamond-drop-v4.schema.json#/$defs/decimal" },
        "endBlock": { "$ref": "diamond-drop-v4.schema.json#/$defs/decimal" },
        "rulesVersion": { "type": "string", "minLength": 1 },
        "rulesPath": { "type": "string", "pattern": "^rules/RULES-v[0-9A-Za-z._-]+\\.md$" },
        "rulesSha256": { "$ref": "diamond-drop-v4.schema.json#/$defs/sha256" },
        "selection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "selectionId", "minimumDurationBlocks", "maximumDurationBlocks", "minimumEndBlock",
            "maximumEndBlock", "selectedDurationBlocks", "entropyBlockNumber", "entropyBlockHash",
            "randomWord", "rejectionCount"
          ],
          "properties": {
            "selectionId": { "$ref": "diamond-drop-v4.schema.json#/$defs/bytes32" },
            "minimumDurationBlocks": { "$ref": "diamond-drop-v4.schema.json#/$defs/positiveDecimal" },
            "maximumDurationBlocks": { "$ref": "diamond-drop-v4.schema.json#/$defs/positiveDecimal" },
            "minimumEndBlock": { "$ref": "diamond-drop-v4.schema.json#/$defs/decimal" },
            "maximumEndBlock": { "$ref": "diamond-drop-v4.schema.json#/$defs/decimal" },
            "selectedDurationBlocks": { "$ref": "diamond-drop-v4.schema.json#/$defs/positiveDecimal" },
            "entropyBlockNumber": { "$ref": "diamond-drop-v4.schema.json#/$defs/positiveDecimal" },
            "entropyBlockHash": { "$ref": "diamond-drop-v4.schema.json#/$defs/bytes32" },
            "randomWord": { "$ref": "diamond-drop-v4.schema.json#/$defs/bytes32" },
            "rejectionCount": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "rewardAmount": { "$ref": "diamond-drop-v4.schema.json#/$defs/positiveDecimal" },
    "floorTokenAmount": { "$ref": "diamond-drop-v4.schema.json#/$defs/positiveDecimal" },
    "eligibilityRule": { "const": "no_outbound_cheap_transfer" },
    "eligibleCount": { "type": "integer", "minimum": 1 },
    "totalWeight": { "$ref": "diamond-drop-v4.schema.json#/$defs/positiveDecimal" },
    "holderSnapshotHash": { "$ref": "diamond-drop-v4.schema.json#/$defs/bytes32" },
    "holderSnapshot": {
      "type": "array", "minItems": 1,
      "items": { "$ref": "#/$defs/holderSnapshotEntry" }
    },
    "allocationRoot": { "$ref": "diamond-drop-v4.schema.json#/$defs/bytes32" },
    "batchesRoot": { "$ref": "diamond-drop-v4.schema.json#/$defs/bytes32" },
    "expectedBatches": { "type": "integer", "minimum": 1 },
    "safeCreateDropCalldata": { "$ref": "diamond-drop-v4.schema.json#/$defs/hexData" },
    "safeFinalizeDropCalldata": { "$ref": "diamond-drop-v4.schema.json#/$defs/hexData" },
    "safeCreateDropTransaction": { "$ref": "diamond-drop-v4.schema.json#/$defs/transaction" },
    "safeFinalizeDropTransaction": { "$ref": "diamond-drop-v4.schema.json#/$defs/transaction" },
    "allocations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/allocation" } },
    "batches": { "type": "array", "minItems": 1, "items": { "$ref": "diamond-drop-v4.schema.json#/$defs/batch" } }
  },
  "$defs": {
    "holderSnapshotEntry": {
      "type": "object", "additionalProperties": false,
      "required": ["address", "minimumBalance", "streak", "outboundTransfer", "excluded"],
      "properties": {
        "address": { "$ref": "diamond-drop-v4.schema.json#/$defs/address" },
        "minimumBalance": { "$ref": "diamond-drop-v4.schema.json#/$defs/decimal" },
        "streak": { "type": "integer", "minimum": 0 },
        "outboundTransfer": { "type": "boolean" },
        "excluded": { "type": "boolean" }
      }
    },
    "allocation": {
      "type": "object", "additionalProperties": false,
      "required": [
        "address", "minimumBalance", "streak", "outboundTransfer", "multiplierBps",
        "weight", "amount", "leaf", "proof"
      ],
      "properties": {
        "address": { "$ref": "diamond-drop-v4.schema.json#/$defs/address" },
        "minimumBalance": { "$ref": "diamond-drop-v4.schema.json#/$defs/decimal" },
        "streak": { "type": "integer", "minimum": 1 },
        "outboundTransfer": { "const": false },
        "multiplierBps": { "$ref": "diamond-drop-v4.schema.json#/$defs/positiveDecimal" },
        "weight": { "$ref": "diamond-drop-v4.schema.json#/$defs/positiveDecimal" },
        "amount": { "$ref": "diamond-drop-v4.schema.json#/$defs/positiveDecimal" },
        "leaf": { "$ref": "diamond-drop-v4.schema.json#/$defs/bytes32" },
        "proof": { "type": "array", "items": { "$ref": "diamond-drop-v4.schema.json#/$defs/bytes32" } }
      }
    }
  }
}
